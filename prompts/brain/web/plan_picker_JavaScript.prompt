<pdd-reason>Switching between work-in-progress mixes is a change of SCOPE, not a step in the Curate-then-Create wizard, so it belongs above the numbered nav rather than inside it.</pdd-reason>
<pdd-interface>
{
  "type": "component",
  "component": {
    "props": [
      {
        "name": "activeSlug",
        "type": "string",
        "required": true
      },
      {
        "name": "plans",
        "type": "Plan[]",
        "required": true
      },
