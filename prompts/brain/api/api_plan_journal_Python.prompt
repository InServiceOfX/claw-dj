{
  "type": "api",
  "api": {
    "endpoints": [
      {
        "method": "GET",
        "path": "/api/plans/<slug>/journal",
        "auth": "none",
        "requestSchema": "?limit=&actor=&author=",
        "responseSchema": "{entries: [{at, actor, author, action, detail, rev_before, rev_after}]}",
        "errors": [
          "404 unknown plan (but empty journal is 200)"
        ]
      }
    ]
  }
}
</pdd-interface>
