<pdd-reason>Editing or retiring a bunch changes the ordering constraints of every plan that activated it, so it needs its own guarded surface.</pdd-reason>
<pdd-interface>
{
  "type": "api",
  "api": {
    "endpoints": [
      {
        "method": "GET",
        "path": "/api/bunches/<bunch_id>",
        "auth": "none",
        "responseSchema": "{bunch_id, label, ordered, notes, members[], archived}"
      },
      {
        "method": "POST",
        "path": "/api/bunches/<bunch_id>",
        "auth": "none",
        "requestSchema": "{label?, notes?, ordered?, track_ids?, action?: 'archive'}",
        "responseSchema": "{bunch_id, members[], archived, auto_archived, affected_slugs: string[]}",
        "errors": [
          "404 unknown bunch"
        ]
      }
    ]
  }
}
</pdd-interface>
