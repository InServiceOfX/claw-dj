<pdd-reason>Creating a library bunch constrains nothing until it is activated for a plan; this is the route that makes a bunch actually hold songs together in one mix.</pdd-reason>
<pdd-interface>
{
  "type": "api",
  "api": {
    "endpoints": [
      {
        "method": "GET",
        "path": "/api/plans/<slug>/bunches",
        "auth": "none",
        "responseSchema": "{activations: [{bunch_id, label, track_ids, ordered, enabled, region, span, archived}]}"
      },
      {
        "method": "POST",
        "path": "/api/plans/<slug>/bunches",
        "auth": "none",
        "requestSchema": "{bunch_id, enabled: bool, region?, base_rev}",
        "responseSchema": "{rev, activation}",
        "errors": [
          "409 {conflicting_bunch_id, shared_track_ids}",
          "409 stale base_rev"
        ]
      }
    ]
  }
}
</pdd-interface>
