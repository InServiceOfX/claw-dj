        ]
      },
      {
        "method": "POST",
        "path": "/api/plans/<slug>",
        "auth": "none",
        "requestSchema": "{display_name?, status?, action?: 'delete', base_rev}",
        "responseSchema": "PlanMeta + rev",
        "errors": [
          "400 unknown status value",
          "409 stale base_rev",
          "409 delete while running"
        ]
      }
    ]
  }
}
