        "path": "/api/plans/<slug>/order",
        "auth": "none",
        "requestSchema": "{track_ids?: string[], move_bunch?: int, to_index?: int, base_rev}",
        "responseSchema": "{rev, order[], orphaned_transitions[]}",
        "errors": [
          "400 not a permutation of current selection",
          "409 stale base_rev",
          "422 order breaks active bunch <id>"
        ]
      }
    ]
  }
}
</pdd-interface>
