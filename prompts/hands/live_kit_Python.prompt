      {"name": "Live", "signature": "Live(mixxx: MixxxControl)", "methods": ["prepare(decks, *, master_gain=None, crossfader=0.0)", "restore()", "save_set(group, key, value)", "pos(deck) -> float", "wait(deck, seconds, lead=0.0)", "automate(clock, track, b0, b1, lanes, *, curve='smooth')", "cut(targets, seconds=CUT_SECONDS)", "eq(deck, low=EQ_UNITY, mid=EQ_UNITY, high=EQ_UNITY)", "vol(deck, value)", "load(deck, track, beat, *, bpm=None, pitch=0.0)", "start(deck, volume=1.0)", "stop(deck)", "recording()"]}
