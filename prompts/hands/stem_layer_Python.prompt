<pdd-reason>Ernest wants Mixxx to play a chosen vocal and instrumental together live at similar levels, for the vocal's whole length, without a .wav render.</pdd-reason>
<pdd-interface>
{
  "type": "module",
  "module": {
    "functions": [
      {
        "name": "schedule",
        "signature": "(plan: dict, *, bed_rate: float | None = None) -> dict"
      },
      {
        "name": "residual_ms",
        "signature": "(plan: dict, rate: float, bed_seconds: float, vocal_seconds: float) -> float"
      },
      {
        "name": "run_layer",
        "signature": "(plan: dict, *, port: int = DEFAULT_PORT, dry_run: bool = False, take_over: bool = False, control_factory=MixxxControl, clock=time.monotonic, sleep=time.sleep, ps_output: str | None = None) -> dict"
      },
      {
        "name": "main",
        "signature": "(argv: list[str] | None = None) -> int"
      }
    ]
  }
}
</pdd-interface>
<pdd-dependency>brain/stem_layer_plan_Python.prompt</pdd-dependency>
