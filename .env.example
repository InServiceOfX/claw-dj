# claw-dj model providers — copy to `.env` (gitignored) and fill in only what
# you use. The signed-in CLIs (claude / codex / grok) need nothing here: run
# `claude auth login`, `codex login`, or `grok login --oauth` once in a terminal.
# With no provider at all, Build mix plan still works (graph optimizer only).

# Claude API key (https://console.anthropic.com). Model defaults to claude-opus-5-5.
# ANTHROPIC_API_KEY=
# CLAWDJ_ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI API key — set the model id you want to use.
# OPENAI_API_KEY=
# CLAWDJ_OPENAI_MODEL=

# xAI Grok API key — set the model id you want to use.
# XAI_API_KEY=
# CLAWDJ_XAI_MODEL=

# Local llama.cpp server (OpenAI-compatible). Start it with e.g.
#   llama-server -hf <repo>:<quant> --port 8080
# LLAMA_SERVER_URL=http://127.0.0.1:8080
# LLAMA_SERVER_MODEL=

# Optional model overrides for the signed-in CLIs.
# CLAWDJ_CLAUDE_CLI_MODEL=
# CLAWDJ_CODEX_CLI_MODEL=
# CLAWDJ_GROK_CLI_MODEL=
